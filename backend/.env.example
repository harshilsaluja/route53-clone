APP_NAME=AWS Route 53 Clone API
# Relative SQLite paths resolve from backend/, independently of shell cwd.
DATABASE_URL=sqlite:///./route53.db
# JSON list; use localhost consistently for frontend and backend in development.
ALLOWED_FRONTEND_ORIGINS=["http://localhost:3000"]
SESSION_COOKIE_NAME=route53_session
SESSION_TTL_SECONDS=86400
# Set true when serving over HTTPS.
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=lax
